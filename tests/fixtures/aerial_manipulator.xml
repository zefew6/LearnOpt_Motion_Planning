<mujoco model="aerial_manipulator_test_fixture">
  <compiler angle="radian" autolimits="true"/>
  <default>
    <default class="quadrotor_parts">
      <geom contype="1" conaffinity="1" condim="4" friction="0.8 0.8 0.005"
            solref="0.005 1" solimp="0.95 0.99 0.001"/>
    </default>
  </default>
  <option timestep="0.001" gravity="0 0 -9.81" integrator="Euler"/>
  <size nuser_site="1"/>
  <custom>
    <numeric name="flight_limits" data="3 2 8 12 0.7"/>
    <numeric name="planning_bounds" data="-3 -2 -1.8 3 2 -0.25"/>
  </custom>
  <worldbody>
    <geom name="ground" type="plane" size="5 5 0.1"/>
    <body name="quadrotor" pos="-2.4 0 1.20" childclass="quadrotor_parts">
      <include file="../../uav_ac/simulation/model/aerial_manipulator.xml"/>
    </body>
    <geom name="target_table" type="box" pos="2 0 0.657" size="0.48 0.42 0.04"/>
    <body name="graspable_object_body" pos="2 0 0.718">
      <freejoint name="graspable_object_freejoint"/>
      <inertial pos="0 0 0" mass="0.020" diaginertia="0.0000013 0.0000018 0.0000018"/>
      <geom name="graspable_object" type="box" size="0.015 0.020 0.020"
            friction="0.8 0.8 0.005" condim="4"/>
    </body>
    <site name="grasp_goal" pos="2 0 0.724" size="0.025" type="sphere"/>
  </worldbody>
  <actuator>
    <motor name="arm_motor_0" joint="arm_joint_0" ctrlrange="-0.8 0.8" ctrllimited="true"/>
    <motor name="arm_motor_1" joint="arm_joint_1" ctrlrange="-0.8 0.8" ctrllimited="true"/>
    <motor name="arm_motor_2" joint="arm_joint_2" ctrlrange="-0.6 0.6" ctrllimited="true"/>
    <motor name="arm_motor_3" joint="arm_joint_3" ctrlrange="-0.4 0.4" ctrllimited="true"/>
    <position name="gripper_position" joint="gripper_left_joint" kp="120" kv="3"
              ctrlrange="0 0.025" ctrllimited="true" forcerange="-2 2" forcelimited="true"/>
  </actuator>
  <equality>
    <joint name="gripper_finger_sync" joint1="gripper_right_joint"
           joint2="gripper_left_joint" polycoef="0 1 0 0 0"/>
  </equality>
</mujoco>
