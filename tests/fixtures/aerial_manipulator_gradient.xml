<mujoco model="aerial_manipulator_gradient_fixture">
  <compiler angle="radian" autolimits="true"/>
  <default>
    <default class="quadrotor_parts"><geom contype="1" conaffinity="1"/></default>
  </default>
  <option timestep="0.001" gravity="0 0 -9.81" integrator="Euler"/>
  <size nuser_site="1"/>
  <statistic center="2 0 1.5" extent="4"/>
  <custom>
    <numeric name="planning_bounds" data="-0.8 -2 -2 4.8 2 -0.7"/>
    <numeric name="flight_limits" data="3 2 8 12 0.7"/>
  </custom>
  <visual>
    <global azimuth="135" elevation="-25"/>
    <map znear="0.01" zfar="30"/>
  </visual>
  <asset>
    <texture name="ground_grid" type="2d" builtin="checker" width="512" height="512"
             rgb1="0.55 0.55 0.55" rgb2="0.35 0.35 0.35"/>
    <material name="ground" texture="ground_grid" texrepeat="8 8" texuniform="true"
              reflectance="0.1"/>
  </asset>
  <worldbody>
    <light name="sun" pos="0 0 8" dir="-0.3 0.2 -1" directional="true"/>
    <geom name="ground" type="plane" size="5 5 0.1" material="ground"/>
    <!-- All dimensions below are authored from the NED task geometry and
         converted to MJCF's ENU frame: (x, y, z)_ENU = (x, -y, -z)_NED.
         Each wall spans NED y=[-3, 3], z=[-3, 0], so it cannot be bypassed
         inside the planning volume.  Its 0.72 m x 0.42 m aperture forces a
         compact arm configuration rather than a base-only detour. -->
    <!-- Wall 1: x=1.00, aperture NED y=[-0.36, 0.36], z=[-1.41, -0.99]. -->
    <geom name="obstacle_wall_1_left" type="box" pos="1 1.68 1.5" size="0.12 1.32 1.5"/>
    <geom name="obstacle_wall_1_right" type="box" pos="1 -1.68 1.5" size="0.12 1.32 1.5"/>
    <geom name="obstacle_wall_1_top" type="box" pos="1 0 2.205" size="0.12 0.36 0.795"/>
    <geom name="obstacle_wall_1_bottom" type="box" pos="1 0 0.495" size="0.12 0.36 0.495"/>
    <!-- Wall 2: x=3.20, aperture NED y=[-0.36, 0.36], z=[-1.61, -1.19]. -->
    <geom name="obstacle_wall_2_left" type="box" pos="3.2 1.68 1.5" size="0.12 1.32 1.5"/>
    <geom name="obstacle_wall_2_right" type="box" pos="3.2 -1.68 1.5" size="0.12 1.32 1.5"/>
    <geom name="obstacle_wall_2_top" type="box" pos="3.2 0 2.305" size="0.12 0.36 0.695"/>
    <geom name="obstacle_wall_2_bottom" type="box" pos="3.2 0 0.595" size="0.12 0.36 0.595"/>
    <!-- -y-facing bookshelf at B.  Its NED free volume is x=[1.84, 2.16],
         y=[0.75, 1.25], z=[-1.19, -0.91] (0.32 m wide by 0.28 m high).
         The top board starts at y=0.84 to leave the vehicle clearance at the
         mouth while still requiring the L-shaped gripper insertion. -->
    <geom name="obstacle_fixture_bottom" type="box" pos="2 -1 0.87" size="0.24 0.25 0.04" rgba="0.48 0.30 0.16 1"/>
    <geom name="obstacle_fixture_top" type="box" pos="2 -1.045 1.23" size="0.24 0.205 0.04" rgba="0.48 0.30 0.16 1"/>
    <geom name="obstacle_fixture_left" type="box" pos="1.8 -1 1.05" size="0.04 0.25 0.14" rgba="0.48 0.30 0.16 1"/>
    <geom name="obstacle_fixture_right" type="box" pos="2.2 -1 1.05" size="0.04 0.25 0.14" rgba="0.48 0.30 0.16 1"/>
    <geom name="obstacle_fixture_back" type="box" pos="2 -1.29 1.05" size="0.24 0.04 0.22" rgba="0.38 0.24 0.13 1"/>
    <body name="quadrotor" pos="0 0 1" childclass="quadrotor_parts">
      <include file="../../uav_ac/simulation/model/aerial_manipulator.xml"/>
    </body>
    <body name="payload_marker" mocap="true">
      <geom name="payload_marker_geom" type="sphere" size="0.035"
            rgba="0.95 0.35 0.08 1" contype="0" conaffinity="0"/>
    </body>
  </worldbody>
  <actuator>
    <motor name="arm_motor_0" joint="arm_joint_0" ctrlrange="-0.8 0.8" ctrllimited="true"/>
    <motor name="arm_motor_1" joint="arm_joint_1" ctrlrange="-0.8 0.8" ctrllimited="true"/>
    <motor name="arm_motor_2" joint="arm_joint_2" ctrlrange="-0.6 0.6" ctrllimited="true"/>
    <motor name="arm_motor_3" joint="arm_joint_3" ctrlrange="-0.4 0.4" ctrllimited="true"/>
    <position name="gripper_position" joint="gripper_left_joint" kp="120" kv="3"
              ctrlrange="0 0.025" ctrllimited="true" forcerange="-2 2" forcelimited="true"/>
  </actuator>
  <equality>
    <joint name="gripper_finger_sync" joint1="gripper_right_joint"
           joint2="gripper_left_joint" polycoef="0 1 0 0 0"/>
  </equality>
</mujoco>
