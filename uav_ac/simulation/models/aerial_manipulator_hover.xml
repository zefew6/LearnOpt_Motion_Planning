<mujoco model="uav_open_field">
  <compiler angle="radian" autolimits="true"/>
  <!-- Select arm and rotor contacts for this scene; the central body always collides. -->
  <default>
    <default class="quadrotor_parts">
      <geom contype="1" conaffinity="1"/>
    </default>
  </default>
  <option timestep="0.001" gravity="0 0 -9.81" integrator="Euler"/>
  <size nuser_site="1"/>
  <statistic center="0 0 12" extent="105"/>

  <custom>
    <!-- NED bounds: north, east, down. -->
    <numeric name="planning_bounds" data="-100 -100 -5 100 100 0"/>
    <numeric name="flight_limits" data="3 2 8 12 0.7"/>
  </custom>

  <visual>
    <global azimuth="90" elevation="-35"/>
    <map znear="0.01" zfar="180"/>
  </visual>

  <asset>
    <texture name="ground_grid" type="2d" builtin="checker" width="512" height="512"
             rgb1="0.55 0.55 0.55" rgb2="0.35 0.35 0.35"/>
    <material name="ground" texture="ground_grid" texrepeat="20 20" texuniform="true"
              reflectance="0.1"/>
  </asset>

  <worldbody>
    <light name="sun" pos="0 0 35" dir="-0.3 0.2 -1" directional="true"/>
    <geom name="ground" type="plane" size="102 102 0.1" material="ground"/>

    <!-- Invisible physical limits keep failures deterministic. -->
    <geom name="world_boundary_north" type="box" pos="100 0 2.5" size="0.1 100 2.5" rgba="0 0 0 0"/>
    <geom name="world_boundary_south" type="box" pos="-100 0 2.5" size="0.1 100 2.5" rgba="0 0 0 0"/>
    <geom name="world_boundary_west" type="box" pos="0 100 2.5" size="100 0.1 2.5" rgba="0 0 0 0"/>
    <geom name="world_boundary_east" type="box" pos="0 -100 2.5" size="100 0.1 2.5" rgba="0 0 0 0"/>
    <geom name="world_boundary_ceiling" type="box" pos="0 0 5.1" size="100 100 0.1" rgba="0 0 0 0"/>

    <!-- Task checkpoints for the deterministic main.py example. The adapter
         prepends the vehicle start; RL bank generation supplies its own route. -->
    <site name="waypoint_00" type="sphere" pos="-35 -18 2.5" size="0.08" rgba="1 0.85 0.1 0.8"/>
    <site name="waypoint_01" type="sphere" pos="30 14 3.5" size="0.08" rgba="1 0.85 0.1 0.8"/>

    <replicate count="200">
      <geom name="trajectory_segment" type="capsule" pos="0 0 -20" size="0.025 0.01"
            contype="0" conaffinity="0" rgba="1 0.25 0.05 0"/>
    </replicate>
    <replicate count="200">
      <geom name="actual_trajectory_segment" type="capsule" pos="0 0 -20" size="0.015 0.01"
            contype="0" conaffinity="0" rgba="0.1 0.4 1 0"/>
    </replicate>
    <site name="goal" type="sphere" pos="90 -4 1.5" size="0.25" rgba="0.1 0.9 0.2 0.8"/>

    <!-- Scene sets the initial pose; the included file defines the vehicle. -->
    <body name="quadrotor" pos="0 0 1" childclass="quadrotor_parts">
      <include file="../model/aerial_manipulator.xml"/>
    </body>
  </worldbody>

  <!-- Arm and gripper controls act on joints from aerial_manipulator.xml. -->
  <actuator>
    <motor name="arm_motor_0" joint="arm_joint_0" ctrlrange="-0.8 0.8" ctrllimited="true" />
    <motor name="arm_motor_1" joint="arm_joint_1" ctrlrange="-0.8 0.8" ctrllimited="true" />
    <motor name="arm_motor_2" joint="arm_joint_2" ctrlrange="-0.6 0.6" ctrllimited="true" />
    <motor name="arm_motor_3" joint="arm_joint_3" ctrlrange="-0.4 0.4" ctrllimited="true" />
    <position name="gripper_position" joint="gripper_left_joint" kp="120" kv="3" ctrlrange="0 0.025" ctrllimited="true" forcerange="-2 2" forcelimited="true" />
  </actuator>


  <!-- Keep the two gripper fingers moving symmetrically. -->
  <equality>
    <joint name="gripper_finger_sync" joint1="gripper_right_joint" joint2="gripper_left_joint" polycoef="0 1 0 0 0" />
  </equality>


</mujoco>
