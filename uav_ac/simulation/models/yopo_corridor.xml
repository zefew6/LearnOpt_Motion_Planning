<mujoco model="yopo_corridor">
  <compiler angle="radian" autolimits="true" />
  <default>
    <default class="quadrotor_parts">
      <geom contype="1" conaffinity="1" />
    </default>
  </default>
  <option timestep="0.001" gravity="0 0 -9.81" integrator="Euler" />
  <size nuser_site="1" />
  <statistic center="2.6 0 1.3" extent="4.5" />
  <custom>
    <numeric name="planning_bounds" data="-1.2 -1.6 -2.4 2.8 1.6 -0.75" />
    <numeric name="flight_limits" data="3 2 8 12 0.7" />
  </custom>
  <visual>
    <global azimuth="135" elevation="-25" />
    <map znear=".0001" zfar="100" />
    <quality offsamples="4" />
  </visual>
  <asset>
    <texture name="ground_grid" type="2d" builtin="checker" width="512" height="512" rgb1="0.55 0.55 0.55" rgb2="0.35 0.35 0.35" />
    <material name="ground" texture="ground_grid" texrepeat="8 8" texuniform="true" reflectance="0.1" />
  </asset>
  <worldbody>
    <light name="sun" pos="2.5 0 8" dir="-0.3 0.2 -1" directional="true" />
    <geom name="ground" type="plane" size="8 5 0.1" material="ground" />
    <body name="quadrotor" pos="0 0 1.5" childclass="quadrotor_parts">
      <include file="../model/aerial_manipulator.xml" />
      <camera name="yopo_depth" pos=".13 0 0" xyaxes="0 -1 0 0 0 1" sensorsize="2 2" resolution="160 96" focalpixel="80 83.1384387633" />
    </body>
    <geom name="obstacle_left" type="box" pos="1.4 -0.95 1.3" size=".6 .18 1.3" rgba=".5 .5 .6 1" />
    <geom name="obstacle_right" type="box" pos="1.4 0.95 1.3" size=".6 .18 1.3" rgba=".5 .5 .6 1" />
  </worldbody>
  <actuator>
    <motor name="arm_motor_0" joint="arm_joint_0" ctrlrange="-0.8 0.8" ctrllimited="true" />
    <motor name="arm_motor_1" joint="arm_joint_1" ctrlrange="-0.8 0.8" ctrllimited="true" />
    <motor name="arm_motor_2" joint="arm_joint_2" ctrlrange="-0.6 0.6" ctrllimited="true" />
    <motor name="arm_motor_3" joint="arm_joint_3" ctrlrange="-0.4 0.4" ctrllimited="true" />
    <position name="gripper_position" joint="gripper_left_joint" kp="120" kv="3" ctrlrange="0 0.025" ctrllimited="true" forcerange="-2 2" forcelimited="true" />
  </actuator>
  <equality>
    <joint name="gripper_finger_sync" joint1="gripper_right_joint" joint2="gripper_left_joint" polycoef="0 1 0 0 0" />
  </equality>
</mujoco>