<mujoco model="uav_bmtp_village">
  <compiler angle="radian" autolimits="true"/>
  <option timestep="0.001" gravity="0 0 -9.81" integrator="Euler"/>
  <size nuser_site="1"/>
  <statistic center="12 -12 3" extent="36"/>

  <custom>
    <numeric name="planning_bounds" data="0 0 -8 24 24 0"/>
    <numeric name="rotor_force_coefficient" data="1"/>
    <numeric name="rotor_drag_to_thrust" data="0.016"/>
    <numeric name="rotor_thrust_limits" data="0.1 4.5"/>
    <numeric name="motor_time_constants" data="0.0125 0.025"/>
    <numeric name="flight_limits" data="3 2 3 12 0.7"/>
  </custom>

  <visual>
    <global azimuth="45" elevation="-55"/>
    <map znear="0.01" zfar="100"/>
  </visual>

  <!-- Built-in assets and vehicle setup reused from lab_course.xml. -->
  <asset>
    <texture name="ground_grid" type="2d" builtin="checker" width="512" height="512"
             rgb1="0.55 0.55 0.55" rgb2="0.35 0.35 0.35"/>
    <material name="ground" texture="ground_grid" texrepeat="8 8" texuniform="true"
              reflectance="0.1"/>
    <material name="frame" rgba="0.35 0.40 0.46 0.65"/>
    <material name="low_obstacle" rgba="0.95 0.55 0.08 0.75"/>
    <material name="tall_obstacle" rgba="0.80 0.18 0.18 0.7"/>
  </asset>

  <worldbody>
    <light name="sun" pos="12 -12 18" dir="-0.3 0.2 -1" directional="true"/>
    <geom name="ground" type="plane" size="30 30 0.1" material="ground"/>
    <camera name="overhead" pos="12 -12 38" quat="1 0 0 0" fovy="45"/>

    <!-- Adapter coordinates: (x, y, z)_NED -> (x, -y, -z)_MuJoCo.
         Heights cycle 2.5, 4, 5.5 in obstacle index order. Traverse each
         successive x row in alternating y directions for an asymmetric grid. -->
    <geom name="obstacle_00" type="box" pos="5 -5 1.25" size="1.25 1.25 1.25" material="low_obstacle"/>
    <geom name="obstacle_01" type="box" pos="5 -10 2" size="1.25 1.25 2" material="frame"/>
    <geom name="obstacle_02" type="box" pos="5 -15 2.75" size="1.25 1.25 2.75" material="tall_obstacle"/>
    <geom name="obstacle_03" type="box" pos="5 -20 1.25" size="1.25 1.25 1.25" material="low_obstacle"/>
    <geom name="obstacle_04" type="box" pos="10 -20 2" size="1.25 1.25 2" material="frame"/>
    <geom name="obstacle_05" type="box" pos="10 -15 2.75" size="1.25 1.25 2.75" material="tall_obstacle"/>
    <geom name="obstacle_06" type="box" pos="10 -10 1.25" size="1.25 1.25 1.25" material="low_obstacle"/>
    <geom name="obstacle_07" type="box" pos="10 -5 2" size="1.25 1.25 2" material="frame"/>
    <geom name="obstacle_08" type="box" pos="15 -5 2.75" size="1.25 1.25 2.75" material="tall_obstacle"/>
    <geom name="obstacle_09" type="box" pos="15 -10 1.25" size="1.25 1.25 1.25" material="low_obstacle"/>
    <geom name="obstacle_10" type="box" pos="15 -15 2" size="1.25 1.25 2" material="frame"/>
    <geom name="obstacle_11" type="box" pos="15 -20 2.75" size="1.25 1.25 2.75" material="tall_obstacle"/>
    <geom name="obstacle_12" type="box" pos="20 -20 1.25" size="1.25 1.25 1.25" material="low_obstacle"/>
    <geom name="obstacle_13" type="box" pos="20 -15 2" size="1.25 1.25 2" material="frame"/>
    <geom name="obstacle_14" type="box" pos="20 -10 2.75" size="1.25 1.25 2.75" material="tall_obstacle"/>
    <geom name="obstacle_15" type="box" pos="20 -5 1.25" size="1.25 1.25 1.25" material="low_obstacle"/>

    <!-- The loader requires one waypoint. Repeating the start adds no
         intermediate constraint; bmtp_route sites describe alternatives. -->
    <site name="waypoint_00" pos="1 -1 2" size="0.01" rgba="0 0 0 0"/>
    <!-- Sites are non-colliding metadata, hidden in every rendering group. -->
    <site name="bmtp_route_00_00" pos="1 -1 2" size="0.01" rgba="0 0 0 0"/>
    <site name="bmtp_route_00_01" pos="1 -23 2" size="0.01" rgba="0 0 0 0"/>
    <site name="bmtp_route_00_02" pos="23 -23 2" size="0.01" rgba="0 0 0 0"/>
    <site name="bmtp_route_01_00" pos="1 -1 2" size="0.01" rgba="0 0 0 0"/>
    <site name="bmtp_route_01_01" pos="23 -1 2" size="0.01" rgba="0 0 0 0"/>
    <site name="bmtp_route_01_02" pos="23 -23 2" size="0.01" rgba="0 0 0 0"/>
    <site name="bmtp_route_02_00" pos="1 -1 2" size="0.01" rgba="0 0 0 0"/>
    <site name="bmtp_route_02_01" pos="1 -12 2" size="0.01" rgba="0 0 0 0"/>
    <site name="bmtp_route_02_02" pos="1 -23 2" size="0.01" rgba="0 0 0 0"/>
    <site name="bmtp_route_02_03" pos="12 -23 2" size="0.01" rgba="0 0 0 0"/>
    <site name="bmtp_route_02_04" pos="23 -23 2" size="0.01" rgba="0 0 0 0"/>
    <site name="bmtp_route_03_00" pos="1 -1 2" size="0.01" rgba="0 0 0 0"/>
    <site name="bmtp_route_03_01" pos="1 -1 6.5" size="0.01" rgba="0 0 0 0"/>
    <site name="bmtp_route_03_02" pos="1 -23 6.5" size="0.01" rgba="0 0 0 0"/>
    <site name="bmtp_route_03_03" pos="23 -23 6.5" size="0.01" rgba="0 0 0 0"/>
    <site name="bmtp_route_03_04" pos="23 -23 2" size="0.01" rgba="0 0 0 0"/>

    <replicate count="200">
      <geom name="trajectory_segment" type="capsule" pos="0 0 -20" size="0.025 0.01"
            contype="0" conaffinity="0" rgba="1 0.25 0.05 0"/>
    </replicate>
    <replicate count="200">
      <geom name="actual_trajectory_segment" type="capsule" pos="0 0 -20" size="0.015 0.01"
            contype="0" conaffinity="0" rgba="0.1 0.4 1 0"/>
    </replicate>
    <site name="goal" type="sphere" pos="23 -23 2" size="0.25" rgba="0.1 0.9 0.2 0.8"/>

    <body name="quadrotor" pos="1 -1 2">
      <freejoint name="quadrotor_freejoint"/>
      <inertial pos="0 0 0" mass="0.5" diaginertia="0.0023 0.0023 0.0046"/>
      <geom name="body" type="box" size="0.08 0.05 0.02" rgba="0.08 0.12 0.16 1"/>
      <geom name="arm_0" type="capsule" fromto="-0.120208 0.120208 0 0.120208 -0.120208 0"
            size="0.008" contype="0" conaffinity="0" rgba="0.25 0.25 0.28 1"/>
      <geom name="arm_1" type="capsule" fromto="-0.120208 -0.120208 0 0.120208 0.120208 0"
            size="0.008" contype="0" conaffinity="0" rgba="0.25 0.25 0.28 1"/>

      <geom name="rotor_visual_0" type="cylinder" pos="0.120208 0.120208 0" size="0.055 0.002"
            contype="0" conaffinity="0" rgba="0.1 0.7 0.9 1"/>
      <geom name="rotor_visual_1" type="cylinder" pos="0.120208 -0.120208 0" size="0.055 0.002"
            contype="0" conaffinity="0" rgba="0.1 0.7 0.9 1"/>
      <geom name="rotor_visual_2" type="cylinder" pos="-0.120208 -0.120208 0" size="0.055 0.002"
            contype="0" conaffinity="0" rgba="0.1 0.7 0.9 1"/>
      <geom name="rotor_visual_3" type="cylinder" pos="-0.120208 0.120208 0" size="0.055 0.002"
            contype="0" conaffinity="0" rgba="0.1 0.7 0.9 1"/>

      <site name="rotor_0" pos="0.120208 0.120208 0" size="0.008" user="1" rgba="0 0.7 1 1"/>
      <site name="rotor_1" pos="0.120208 -0.120208 0" size="0.008" user="-1" rgba="0 0.7 1 1"/>
      <site name="rotor_2" pos="-0.120208 -0.120208 0" size="0.008" user="1" rgba="0 0.7 1 1"/>
      <site name="rotor_3" pos="-0.120208 0.120208 0" size="0.008" user="-1" rgba="0 0.7 1 1"/>
    </body>
  </worldbody>
</mujoco>
